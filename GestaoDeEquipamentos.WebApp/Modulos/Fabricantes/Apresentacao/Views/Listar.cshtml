@model List<ListarFabricanteViewModel>

  @{
    Layout= "_Layout";
    ViewBag.Titulo = "Listagem de Fabricantes";
  }  

  <p>
    <a class="btn btn-primary" asp-action="Cadastrar">
        <i class="bi bi-patch-plus"></i>
        Cadastrar fabricante
    </a>
  </p>

  @if(Model.Count == 0)
  {
    <div class="alert alert-warning mt-4" role="alert">
        Não há nenhum fabricante 
    </div>
  }