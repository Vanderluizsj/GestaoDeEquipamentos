@{
    Layout = "_Layout";
    ViewBag.Titulo = "Página Inicial";
    //ViewBag.BodyClass = "fundo-index";
}

<div class="row gap-3 gap-lg-0 mt-4">
    <div class="col">
        <h2>Boas-vindas à Gestão de Equipamentos!</h2>
        <hr>
        <p class="mt-4">
            Experimente as funcionalidades da nossa aplicação. Você pode gerenciar fabricantes, equipamentos e chamados.
        </p>

        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 mt-2">
            <div class="col">
                <div class="card border-primary h-100 position-relative">
                    <div class="card-body text-center d-flex flex-column justify-content-center">
                        <i class="bi bi-globe fs-1 mb-2"></i>
                        <h5 class="card-title">Fabricante</h5>
                        <!-- O stretched-link faz o card inteiro virar clicável -->
                        <a class="stretched-link text-decoration-none" asp-controller="Fabricante" asp-action="Listar"
                           title="Editar"></a>
                    </div>
                </div>
            </div>

            <div class="col">
                <div class="card border-primary h-100 position-relative">
                    <div class="card-body text-center d-flex flex-column justify-content-center">
                        <i class="bi bi-pc-display-horizontal fs-1 mb-2"></i>
                        <h5 class="card-title">Equipamentos</h5>
                        <!-- O stretched-link faz o card inteiro virar clicável -->
                        <a class="stretched-link text-decoration-none" asp-controller="Equipamento" asp-action="Listar"
                           title="Editar"></a>
                    </div>
                </div>
            </div>

            <div class="col">
                <div class="card border-primary h-100 position-relative">
                    <div class="card-body text-center d-flex flex-column justify-content-center">
                        <i class="bi bi-card-heading fs-1 mb-2"></i>
                        <h5 class="card-title">Chamado</h5>
                        <!-- O stretched-link faz o card inteiro virar clicável -->
                        <a class="stretched-link text-decoration-none" asp-controller="Chamado" asp-action="Listar"
                           title="Editar"></a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-6">
        <img class="img-fluid" src="~/img/undraw_logistics.svg" />
    </div>

</div>